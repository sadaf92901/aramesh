# ============================================================
# Flask — اجباری
# ============================================================
SECRET_KEY=change-me-in-production
FLASK_ENV=development
# مقادیر مجاز: development | production | testing


# ============================================================
# Database — اجباری
# ============================================================
# SQLite (ساده):
# DATABASE_URL=sqlite:///aramesh.db

# PostgreSQL (production):
DATABASE_URL=postgresql://aramesh:aramesh123@localhost:5432/aramesh


# ============================================================
# LLM Provider — اجباری
# ============================================================
LLM_ENABLED=true
LLM_PROVIDER=openai
# مقادیر مجاز: openai | gemini | local
LLM_TEMPERATURE=0.7


# ============================================================
# AvalAI (OpenAI compatible) — اجباری برای LLM/Speech
# ============================================================
OPENAI_API_KEY=aa-...
OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1


# ============================================================
# Gemini — اختیاری
# ============================================================
# برای گرفتن: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ============================================================
# Speech Provider — اجباری
# ============================================================
SPEECH_ENABLED=true
SPEECH_PROVIDER=avalai
# مقادیر مجاز: avalai | gemini | local
WHISPER_MODEL=base


# ============================================================
# RAG — اختیاری
# ============================================================
RAG_ENABLED=true
RAG_TOP_K=3


# ============================================================
# Email — اختیاری
# ============================================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=mock
# مقادیر مجاز: mock | smtp

# اگه EMAIL_PROVIDER=smtp بود:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@aramesh.app
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@aramesh.app