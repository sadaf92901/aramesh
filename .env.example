# ============================================================
# همراه آرامش — نمونه‌ی تنظیمات محیطی
# ============================================================
#
# نحوه استفاده:
#   ۱. یه کپی بگیر: cp .env.example .env
#   ۲. مقادیر واقعی رو توش بذار
#   ۳. ⚠️ فایل .env رو هیچ‌وقت commit نکن!
#
# برای ساخت SECRET_KEY امن:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================


# ============================================================
# Flask — اجباری
# ============================================================
SECRET_KEY=change-me-in-production
FLASK_ENV=development
# مقادیر مجاز: development | production | testing


# ============================================================
# AvalAI (LLM + Speech) — اجباری
# ============================================================
# برای گرفتن API Key: https://chat.avalai.ir
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.avalai.ir/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1


# ============================================================
# Gemini API — اختیاری
# ============================================================
# برای گرفتن: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ============================================================
# دیتابیس — اختیاری
# ============================================================
# پیش‌فرض: SQLite (sqlite:///aramesh.db)
#
# PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/aramesh
#
# MySQL:
#   DATABASE_URL=mysql+pymysql://user:password@localhost/aramesh
#
# DATABASE_URL=


# ============================================================
# سرویس‌ها — اختیاری (پیش‌فرض: همه true)
# ============================================================
LLM_ENABLED=true
LLM_PROVIDER=openai
# مقادیر مجاز: openai | local
LLM_TEMPERATURE=0.7

SPEECH_ENABLED=true
SPEECH_PROVIDER=avalai
# مقادیر مجاز: avalai | local | gemini

RAG_ENABLED=true
RAG_TOP_K=3


# ============================================================
# Email — اختیاری
# ============================================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=mock
# مقادیر مجاز: mock | smtp

# اگه EMAIL_PROVIDER=smtp بود، اینا رو پر کن:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@aramesh.app
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@aramesh.app


# ============================================================
# CORS — اختیاری
# ============================================================
# فقط برای دامنه‌های مجاز
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ============================================================
# Deployment — اختیاری
# ============================================================
# PORT=5000
# WORKERS=4
# LOG_LEVEL=INFO


# ============================================================
# Logging — اختیاری
# ============================================================
# LOG_LEVEL=INFO
# مقادیر مجاز: DEBUG | INFO | WARNING | ERROR | CRITICAL